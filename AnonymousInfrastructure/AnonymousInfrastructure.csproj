<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="EmailTemplates\CompanyApproved.html" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="EmailTemplates\CompanyApproved.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="dbup-sqlserver" Version="7.2.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AnonymousApplication\AnonymousApplication.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Migrations\Scripts\*.sql" />
	</ItemGroup>
</Project>
